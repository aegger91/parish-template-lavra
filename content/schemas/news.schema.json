{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "news.schema.json",
  "title": "News",
  "description": "Articles, newest first by date. Each gets its own page at /news/{id}/.",
  "type": "object",
  "required": [
    "categories",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/category"
      },
      "minItems": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "date",
          "category",
          "image",
          "title",
          "summary",
          "body"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "date": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "category": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "image": {
            "$ref": "common.schema.json#/$defs/imagePath"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "summary": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "body": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/localized"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
