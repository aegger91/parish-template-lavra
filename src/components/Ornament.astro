---
interface Props {
  variant?: 'vine' | 'embroidery' | 'arch' | 'rope' | 'floral';
  align?: 'center' | 'start';
}
const { variant = 'arch', align = 'center' } = Astro.props;
const map = {
  vine: '/icons/ornament-vine.svg',
  embroidery: '/icons/ornament-embroidery.svg',
  arch: '/icons/ornament-arch.svg',
  rope: '/icons/ornament-rope.svg',
  floral: '/icons/ornament-floral.svg',
} as const;
---
<div class:list={['ornament', align === 'start' && 'ornament--start']} aria-hidden="true">
  <img src={map[variant]} alt="" width="400" height="48" />
</div>
