---
interface Props {
  align?: 'center' | 'start';
  light?: boolean;
}
const { align = 'start', light = false } = Astro.props;
---
<div class:list={['rule', align === 'start' && 'rule--start', light && 'rule--light']} aria-hidden="true">
  <img src="/icons/cross-trefoil.svg" alt="" width="18" height="18" />
</div>
