---
import SerbianCross from './SerbianCross.astro';

interface Props {
  class?: string;
  variant?: 'band' | 'line' | 'rosette-line' | 'cross-line';
}
const { class: className = '', variant = 'band' } = Astro.props;
---
{variant === 'band' && (
  <div class:list={['morava-ornament', 'morava-ornament--band', className]} aria-hidden="true">
    <span class="morava-ornament__rule"></span>
  </div>
)}
{(variant === 'line' || variant === 'cross-line') && (
  <div class:list={['morava-ornament', 'morava-ornament--line', className]} aria-hidden="true">
    <span class="morava-ornament__rail"></span>
    <SerbianCross class="morava-ornament__cross" size={18} decorative />
    <span class="morava-ornament__rail"></span>
  </div>
)}
{variant === 'rosette-line' && (
  <div class:list={['morava-ornament', 'morava-ornament--rosette', className]} aria-hidden="true">
    <span class="morava-ornament__rail"></span>
    <span class="morava-ornament__ring">
      <SerbianCross class="morava-ornament__cross" size={20} decorative />
    </span>
    <span class="morava-ornament__rail"></span>
  </div>
)}
