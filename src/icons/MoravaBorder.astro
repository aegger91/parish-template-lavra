---
interface Props {
  class?: string;
  variant?: 'band' | 'line' | 'rosette-line' | 'cross-line';
}
const { class: className = '', variant = 'band' } = Astro.props;
const gradId = `bandGold-${Math.random().toString(36).slice(2, 9)}`;
---
{variant === 'band' && (
  <div class:list={['morava-ornament', 'morava-ornament--band', className]} aria-hidden="true">
    <svg viewBox="0 0 800 8" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="var(--gold-dim)" stop-opacity="0.15" />
          <stop offset="35%" stop-color="var(--gold)" stop-opacity="0.85" />
          <stop offset="50%" stop-color="var(--gold-bright)" stop-opacity="1" />
          <stop offset="65%" stop-color="var(--gold)" stop-opacity="0.85" />
          <stop offset="100%" stop-color="var(--gold-dim)" stop-opacity="0.15" />
        </linearGradient>
      </defs>
      <rect y="3" width="800" height="1" fill={`url(#${gradId})`} />
      <rect x="392" y="1.5" width="16" height="5" fill="var(--marble)" />
      <!-- Tiny Serbian cross center -->
      <g transform="translate(400 4)" fill="var(--gold)">
        <rect x="-0.7" y="-3.2" width="1.4" height="6.4" rx="0.2" />
        <rect x="-2.6" y="-1.1" width="5.2" height="1.3" rx="0.2" />
        <rect x="-1.8" y="1.3" width="3.6" height="1.1" rx="0.2" />
      </g>
    </svg>
  </div>
)}
{variant === 'line' && (
  <div class:list={['morava-ornament', 'morava-ornament--line', className]} aria-hidden="true">
    <svg viewBox="0 0 240 14" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 7 H98" stroke="currentColor" stroke-width="1" opacity="0.45" />
      <path d="M142 7 H240" stroke="currentColor" stroke-width="1" opacity="0.45" />
      <g transform="translate(120 7)" fill="currentColor">
        <rect x="-0.85" y="-4.2" width="1.7" height="8.4" rx="0.25" />
        <rect x="-3.2" y="-1.4" width="6.4" height="1.5" rx="0.25" />
        <rect x="-2.2" y="1.6" width="4.4" height="1.3" rx="0.25" />
      </g>
    </svg>
  </div>
)}
{variant === 'cross-line' && (
  <div class:list={['morava-ornament', 'morava-ornament--line', className]} aria-hidden="true">
    <svg viewBox="0 0 180 14" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 7 H68" stroke="currentColor" stroke-width="1" opacity="0.5" />
      <path d="M112 7 H180" stroke="currentColor" stroke-width="1" opacity="0.5" />
      <g transform="translate(90 7)" fill="currentColor">
        <rect x="-0.85" y="-4.2" width="1.7" height="8.4" rx="0.25" />
        <rect x="-3.2" y="-1.4" width="6.4" height="1.5" rx="0.25" />
        <rect x="-2.2" y="1.6" width="4.4" height="1.3" rx="0.25" />
      </g>
    </svg>
  </div>
)}
{variant === 'rosette-line' && (
  <div class:list={['morava-ornament', 'morava-ornament--rosette', className]} aria-hidden="true">
    <svg viewBox="0 0 280 28" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 14 H108" stroke="currentColor" stroke-width="1" opacity="0.4" />
      <path d="M172 14 H280" stroke="currentColor" stroke-width="1" opacity="0.4" />
      <circle cx="140" cy="14" r="11" fill="none" stroke="currentColor" stroke-width="1" opacity="0.7" />
      <g transform="translate(140 14)" fill="currentColor">
        <rect x="-0.7" y="-5" width="1.4" height="10" rx="0.2" />
        <rect x="-3.4" y="-1.5" width="6.8" height="1.4" rx="0.2" />
        <rect x="-2.3" y="2" width="4.6" height="1.2" rx="0.2" />
      </g>
    </svg>
  </div>
)}
