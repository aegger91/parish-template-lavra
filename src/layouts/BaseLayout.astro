---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import { siteConfig } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/header.css';
import '../styles/home.css';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  path?: string;
}

const { locale, title, description = '', path = '' } = Astro.props;
const dict = t(locale);
const parish = siteConfig.parishName[locale];
const fullTitle = title ? `${title} · ${parish}` : parish;
const langAttr = locale === 'sr' ? 'sr-Cyrl' : locale === 'lat' ? 'sr-Latn' : 'en';
---
<!doctype html>
<html lang={langAttr}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || siteConfig.tagline[locale]} />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Old+Standard+TT:ital,wght@0,400;0,700;1,400&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{dict.a11y.skip}</a>
    <Header locale={locale} path={path} />
    <div class="morava-band" aria-hidden="true"></div>
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
