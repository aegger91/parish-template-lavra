---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import { siteConfig } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MoravaBorder from '../icons/MoravaBorder.astro';
import '../styles/global.css';
import '../styles/header.css';
import '../styles/home.css';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  path?: string;
}

const { locale, title, description = '', path = '' } = Astro.props;
const dict = t(locale);
const parish = siteConfig.parishName[locale];
const fullTitle = title ? `${title} · ${parish}` : parish;
const langAttr = locale === 'sr' ? 'sr-Cyrl' : locale === 'lat' ? 'sr-Latn' : 'en';
---
<!doctype html>
<html lang={langAttr} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || siteConfig.tagline[locale]} />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">{dict.a11y.skip}</a>
    <Header locale={locale} path={path} />
    <div class="site-rule" aria-hidden="true">
      <MoravaBorder variant="band" />
    </div>
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var reduce =
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function showAll() {
          root.classList.add('reveal-fallback');
          document.querySelectorAll('.reveal').forEach(function (el) {
            el.classList.add('is-visible');
            el.classList.add('reveal-forced');
          });
        }

        if (reduce) {
          showAll();
          return;
        }

        var nodes = document.querySelectorAll('.reveal');
        if (!nodes.length) return;

        var revealed = 0;
        function mark(el) {
          if (el.classList.contains('is-visible')) return;
          el.classList.add('is-visible');
          revealed += 1;
          if (revealed >= nodes.length) root.classList.add('reveal-ready');
        }

        // Timeout fallback: never leave content hidden
        var failSafe = window.setTimeout(showAll, 1800);

        if (!('IntersectionObserver' in window)) {
          showAll();
          window.clearTimeout(failSafe);
          return;
        }

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting || entry.intersectionRatio > 0) {
                mark(entry.target);
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );

        nodes.forEach(function (el) {
          // In-view on load (hero): reveal immediately
          var rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.92 && rect.bottom > 0) {
            mark(el);
          } else {
            io.observe(el);
          }
        });

        window.addEventListener(
          'load',
          function () {
            window.setTimeout(function () {
              document.querySelectorAll('.reveal:not(.is-visible)').forEach(mark);
              root.classList.add('reveal-ready');
              window.clearTimeout(failSafe);
            }, 1200);
          },
          { once: true },
        );
      })();
    </script>
  </body>
</html>
