---
import type { Locale } from '../config/site';
import { siteConfig } from '../config/site';
import { images } from '../config/images';
import { t } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  current?: string;
}
const { locale, title, description = '', current = 'home' } = Astro.props;
const dict = t(locale);
const fullTitle = `${title} · ${siteConfig.name[locale]}`;
const og = images.og.src;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || siteConfig.tagline[locale]} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description || siteConfig.tagline[locale]} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={locale === 'ro' ? 'ro_RO' : 'en_GB'} />
    <link rel="icon" href="/icons/cross-trefoil.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,500;7..72,700&family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{dict.a11y.skip}</a>
    <Header locale={locale} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
