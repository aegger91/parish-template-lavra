---
import BaseLayout from '../layouts/BaseLayout.astro';
import NotFound from '../components/NotFound.astro';
import { t, localizedPath } from '../i18n/ui';

const locale = 'sr';
const dict = t(locale);
---
<BaseLayout locale={locale} title={dict.notFound.title} path="404">
  <NotFound locale={locale}>
    <p class="lang-alt">
      <a href={localizedPath('lat', '')} lang="sr-Latn">Latinica</a>
      <a href={localizedPath('en', '')} lang="en">English</a>
    </p>
  </NotFound>
</BaseLayout>
