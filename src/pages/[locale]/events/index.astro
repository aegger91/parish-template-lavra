---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Rosette from '../../../icons/Rosette.astro';
import { locales, t, localizedPath, type Locale } from '../../../i18n/ui';
import { newsItems } from '../../../config/news';
import { formatDate } from '../../../i18n/utils';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = t(locale);
---
<BaseLayout locale={locale} title={dict.events.title} path="events" description={dict.events.intro}>
  <section class="page-hero">
    <div class="container">
      <div class="section-ornament" style="justify-content: flex-start; margin-bottom: var(--space-3);">
        <Rosette size={28} />
      </div>
      <h1>{dict.events.title}</h1>
      <p>{dict.events.intro}</p>
    </div>
  </section>
  <section class="section" style="padding-top: 0;">
    <div class="container" style="max-width: 44rem;">
      <ul class="news-list">
        {
          newsItems.map((n) => (
            <li class="news-item">
              <time datetime={n.date}>{formatDate(n.date, locale, { full: true })}</time>
              <h3>
                <a href={localizedPath(locale, `events/${n.id}`)}>{n.title[locale]}</a>
              </h3>
              <p>{n.summary[locale]}</p>
              <a href={localizedPath(locale, `events/${n.id}`)}>{dict.events.readMore}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
