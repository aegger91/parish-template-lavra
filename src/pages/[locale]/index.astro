---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchedulePanel from '../../components/SchedulePanel';
import MoravaBorder from '../../icons/MoravaBorder.astro';
import { locales, t, localizedPath, type Locale } from '../../i18n/ui';
import { siteConfig } from '../../config/site';
import { images } from '../../config/images';
import { weekServices, nextFeast } from '../../config/schedule';
import { newsItems } from '../../config/news';
import { formatDate, formatServiceDateLabel } from '../../i18n/utils';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = t(locale);

const scheduleItems = weekServices.map((s) => ({
  id: s.id,
  title: s.title[locale],
  description: s.description[locale],
  date: s.date,
  start: s.start,
  end: s.end,
  location: s.location[locale],
  oldStyleDate: s.oldStyleDate,
  feast: s.feast?.[locale],
}));

const nextService = weekServices[0];
const nextServiceLabel = formatServiceDateLabel(
  nextService.date,
  locale,
  siteConfig.calendarStyle,
  nextService.oldStyleDate,
  dict.schedule.oldStyleSuffix,
);

const feastItem = {
  id: nextFeast.id,
  title: nextFeast.title[locale],
  description: nextFeast.description[locale],
  date: nextFeast.date,
  start: nextFeast.start,
  end: nextFeast.end,
  location: nextFeast.location[locale],
  oldStyleDate: nextFeast.oldStyleDate,
  feast: nextFeast.feast?.[locale],
};

const feastDateLabel = formatServiceDateLabel(
  nextFeast.date,
  locale,
  siteConfig.calendarStyle,
  nextFeast.oldStyleDate,
  dict.schedule.oldStyleSuffix,
);

const lead = {
  sr: 'Добродошли у нашу парохију. Богослужења, вести и контакт на једном месту.',
  lat: 'Dobrodošli u našu parohiju. Bogosluženja, vesti i kontakt na jednom mestu.',
  en: 'Welcome to our parish. Services, news, and contact in one place.',
}[locale];

const addressLine = `${siteConfig.address.street}, ${siteConfig.address.city}`;
---
<BaseLayout locale={locale} title="" path="">
  <section class="home-hero">
    <div class="home-hero__media">
      <img
        src={images.hero.src}
        alt={images.hero.alt[locale]}
        width="2560"
        height="2048"
        fetchpriority="high"
      />
    </div>
    <div class="home-hero__veil" aria-hidden="true"></div>
    <div class="home-hero__content">
      <p class="home-hero__tag">{siteConfig.tagline[locale]}</p>
      <h1 class="home-hero__brand">{siteConfig.parishName[locale]}</h1>
      <div class="home-hero__divider" aria-hidden="true">
        <MoravaBorder variant="cross-line" />
      </div>
      <p class="home-hero__lead">{lead}</p>
      <div class="home-hero__cta">
        <a class="btn btn--gold" href={localizedPath(locale, 'schedule')}>{dict.home.viewSchedule}</a>
        <a class="btn btn--outline-light" href={localizedPath(locale, 'contact')}>
          {dict.nav.contact}
        </a>
        <a class="home-hero__link" href={localizedPath(locale, 'pomen')}>{dict.nav.pomen}</a>
      </div>
    </div>
  </section>

  <section class="home-glance" aria-label={dict.home.glanceLabel}>
    <div class="container">
      <div class="home-glance__inner">
        <a class="home-glance__cell" href={localizedPath(locale, 'schedule')}>
          <p class="home-glance__label">{dict.home.glanceNext}</p>
          <p class="home-glance__title">{nextService.title[locale]}</p>
          <p class="home-glance__meta">
            {nextServiceLabel} · {nextService.start}–{nextService.end}
          </p>
        </a>
        <a class="home-glance__cell" href={localizedPath(locale, 'slava')}>
          <p class="home-glance__label">{dict.home.glanceFeast}</p>
          <p class="home-glance__title">{feastItem.title}</p>
          <p class="home-glance__meta">{feastDateLabel}</p>
        </a>
        <a class="home-glance__cell" href={localizedPath(locale, 'contact')}>
          <p class="home-glance__label">{dict.home.glanceVisit}</p>
          <p class="home-glance__title">{addressLine}</p>
          <p class="home-glance__meta">{siteConfig.phone}</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section home-layer">
    <div class="container">
      <div class="home-layer__inner">
        <p class="eyebrow">{dict.home.chapterWeek}</p>
        <div class="section-head">
          <h2>{dict.home.thisWeek}</h2>
          <a href={localizedPath(locale, 'schedule')}>{dict.home.viewSchedule}</a>
        </div>
        <SchedulePanel
          client:load
          items={scheduleItems}
          locale={locale}
          calendarStyle={siteConfig.calendarStyle}
          mapQuery={siteConfig.mapQuery}
          labels={{ ...dict.schedule, openDetails: dict.a11y.openDetails }}
        />
      </div>
    </div>
  </section>

  <section class="section section--parchment">
    <div class="container">
      <div class="slava-feature">
        <div>
          <p class="eyebrow">{dict.home.featuredSlava}</p>
          <div class="feast-feature">
            <p class="feast-feature__label">{dict.home.nextFeast}</p>
            <h3>{feastItem.title}</h3>
            <p class="feast-feature__meta">
              {feastDateLabel} · {feastItem.start}–{feastItem.end} · {feastItem.location}
            </p>
            <p>{feastItem.description}</p>
            <SchedulePanel
              client:load
              items={[feastItem]}
              locale={locale}
              calendarStyle={siteConfig.calendarStyle}
              mapQuery={siteConfig.mapQuery}
              labels={{ ...dict.schedule, openDetails: dict.a11y.openDetails }}
            />
            <p>
              <a class="btn btn--red" href={localizedPath(locale, 'slava')}>{dict.nav.slava}</a>
            </p>
          </div>
        </div>
        <div class="slava-feature__media">
          <img
            src={images.parish.src}
            alt={images.parish.alt[locale]}
            width="1800"
            height="1350"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  {
    (siteConfig.showAboutBlock || siteConfig.showVisitingBlock) && (
      <section class="section section--quiet">
        <div class="container">
          <MoravaBorder variant="line" />
          <div class="optional-blocks">
            {siteConfig.showAboutBlock && (
              <div class="optional-block">
                <p class="eyebrow">{dict.home.chapterAbout}</p>
                <h2>{dict.home.aboutTitle}</h2>
                <p>{dict.home.aboutText}</p>
                <a href={localizedPath(locale, 'parish')}>{dict.nav.parish}</a>
              </div>
            )}
            {siteConfig.showVisitingBlock && (
              <div class="optional-block">
                <p class="eyebrow">{dict.home.chapterVisit}</p>
                <h2>{dict.home.visitingTitle}</h2>
                <p>{dict.home.visitingText}</p>
                <a href={localizedPath(locale, 'contact')}>{dict.nav.contact}</a>
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--parchment">
    <div class="container fresco-panel">
      <div class="fresco-panel__frame">
        <img
          src={images.fresco.src}
          alt={images.fresco.alt[locale]}
          width="1200"
          height="1700"
          loading="lazy"
        />
      </div>
      <div class="fresco-panel__copy">
        <p class="eyebrow">{dict.home.chapterHeritage}</p>
        <h2>{dict.home.frescoTitle}</h2>
        <p>{dict.home.frescoText}</p>
        <div class="section-head" style="margin-top: var(--space-6);">
          <h3 style="margin:0; font-size: clamp(1.35rem, 2.2vw, 1.7rem);">{dict.home.news}</h3>
          <a href={localizedPath(locale, 'events')}>{dict.home.viewAll}</a>
        </div>
        <ul class="news-list">
          {
            newsItems.slice(0, 2).map((n) => (
              <li class="news-item">
                <time datetime={n.date}>{formatDate(n.date, locale)}</time>
                <h3>
                  <a href={localizedPath(locale, `events/${n.id}`)}>{n.title[locale]}</a>
                </h3>
                <p>{n.summary[locale]}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">{dict.home.chapterGallery}</p>
      <div class="section-head">
        <h2>{dict.home.gallery}</h2>
      </div>
      <div class="gallery-strip">
        {
          images.gallery.map((g) => (
            <figure>
              <img src={g.src} alt={g.alt[locale]} width="640" height="480" loading="lazy" />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="donate-band">
    <div class="container">
      <MoravaBorder variant="line" />
      <h2>{dict.home.donateBand}</h2>
      <p>{dict.home.donateBandText}</p>
      <a class="btn btn--gold" href={localizedPath(locale, 'donate')}>{dict.home.donateCta}</a>
    </div>
  </section>
</BaseLayout>
