---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchedulePanel from '../../components/SchedulePanel';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Tile from '../../components/Tile.astro';
import SerbianCross from '../../icons/SerbianCross.astro';
import Icon from '../../icons/Icon.astro';
import { locales, t, localizedPath, type Locale } from '../../i18n/ui';
import { localize, pages } from '../../i18n/pages';
import { siteConfig } from '../../config/site';
import { weekServices, localizeServices } from '../../config/schedule';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = t(locale);
const c = localize(pages.common, locale);
const p = localize(pages.livestream, locale);
const help = localize(pages.schedule.help, locale);
const pomen = localize(pages.pomen.more, locale);
const href = (path: string) => localizedPath(locale, path);
const hasStream = !siteConfig.livestreamUrl.includes('PLACEHOLDER');
const services = localizeServices(weekServices, locale);
---
<BaseLayout locale={locale} title={dict.livestream.title} path="livestream" description={dict.livestream.intro}>
  <PageHero
    image="/images/gallery-1.webp"
    position="center 40%"
    eyebrow={p.eyebrow}
    title={dict.livestream.title}
    lead={dict.livestream.intro}
    crumbsLabel={c.crumbs}
    crumbs={[{ label: dict.nav.home, href: href('') }, { label: dict.livestream.title }]}
  />

  <section class="section reveal">
    <div class="container schedule-layout">
      <div>
        <p class="eyebrow live-dot">{p.eyebrow}</p>
        <div class="player">
          <div class="livestream-frame">
            {hasStream ? (
              <iframe
                src={siteConfig.livestreamUrl}
                title={dict.livestream.title}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            ) : (
              <div class="player-offline">
                <img src="/images/fresco-studenica-saints.webp" alt="" loading="lazy" decoding="async" />
                <div class="player-offline__body">
                  <span class="player-offline__ring" aria-hidden="true"><SerbianCross size={30} decorative /></span>
                  <h2>{p.offlineTitle}</h2>
                  <p>{p.offlineText}</p>
                  <a class="btn btn--gold" href={href('schedule')}>{dict.nav.schedule}</a>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>

      <aside class="aside-card">
        <h2>{p.nextTitle}</h2>
        <SchedulePanel
          client:load
          items={services}
          locale={locale}
          calendarStyle={siteConfig.calendarStyle}
          mapQuery={siteConfig.mapQuery}
          labels={{ ...dict.schedule, openDetails: dict.a11y.openDetails }}
          variant="rich"
        />
        <a class="more-link" href={href('schedule')}>{c.fullSchedule} <Icon name="arrow" size={18} /></a>
      </aside>
    </div>
  </section>

  <section class="section section--parchment reveal">
    <div class="container">
      <SectionHead eyebrow={p.helpEyebrow} title={p.helpTitle} center />
      <div class="tile-grid">
        <Tile icon="candle" title={dict.nav.pomen} text={help.pomen} href={href('pomen')} more={c.more} />
        <Tile icon="heart" title={dict.nav.donate} text={pomen.donate} href={href('donate')} more={c.more} />
        <Tile icon="calendar" title={dict.nav.schedule} text={c.upcoming} href={href('schedule')} more={c.more} />
      </div>
    </div>
  </section>
</BaseLayout>
