---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormShell from '../../components/FormShell.astro';
import PhoneInput from '../../components/PhoneInput';
import AmountField from '../../components/AmountField';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Tile from '../../components/Tile.astro';
import OfficeLines from '../../components/OfficeLines.astro';
import SerbianCross from '../../icons/SerbianCross.astro';
import Icon from '../../icons/Icon.astro';
import { locales, t, localizedPath, type Locale } from '../../i18n/ui';
import { localize, pages } from '../../i18n/pages';
import { siteConfig } from '../../config/site';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = t(locale);
const c = localize(pages.common, locale);
const p = localize(pages.pomen, locale);
const href = (path: string) => localizedPath(locale, path);
const sideIcons = ['scroll', 'heart', 'door'];
---
<BaseLayout locale={locale} title={dict.pomen.title} path="pomen" description={dict.pomen.intro}>
  <PageHero
    image="/images/fresco-gracanica.webp"
    position="center 32%"
    eyebrow={p.eyebrow}
    title={dict.pomen.title}
    lead={dict.pomen.intro}
    crumbsLabel={c.crumbs}
    crumbs={[{ label: dict.nav.home, href: href('') }, { label: dict.pomen.title }]}
  >
    <Fragment slot="actions">
      <a class="btn btn--gold" href="#names">{p.formTitle}</a>
      <a class="btn btn--outline-light" href={href('schedule')}>{dict.nav.schedule}</a>
    </Fragment>
  </PageHero>

  <section class="section reveal" id="names">
    <div class="container form-layout">
      <div class="form-card">
        <header class="form-card__head">
          <p class="eyebrow">{p.formEyebrow}</p>
          <h2>{p.formTitle}</h2>
        </header>
        <FormShell submitLabel={dict.pomen.submit} successMessage={dict.pomen.success}>
          <fieldset class="choice-group">
            <legend>{p.kind}</legend>
            <div class="choice-row">
              <label class="choice">
                <input type="radio" name="kind" value="living" checked required />
                <span class="choice__mark" aria-hidden="true"></span>
                <span class="choice__label">{dict.pomen.living}</span>
              </label>
              <label class="choice">
                <input type="radio" name="kind" value="departed" />
                <span class="choice__mark" aria-hidden="true"></span>
                <span class="choice__label">{dict.pomen.departed}</span>
              </label>
            </div>
          </fieldset>
          <div class="form-row">
            <label for="pomen-names">{dict.pomen.names}</label>
            <p class="hint">{dict.pomen.namesHint}</p>
            <textarea id="pomen-names" name="names" required rows="6"></textarea>
          </div>
          <div class="form-grid">
            <div class="form-row">
              <label for="pomen-name">{dict.pomen.name}</label>
              <input id="pomen-name" name="name" type="text" required autocomplete="name" />
            </div>
            <div class="form-row">
              <label for="pomen-email">{dict.pomen.email}</label>
              <input id="pomen-email" name="email" type="email" required autocomplete="email" />
            </div>
            <PhoneInput client:load id="pomen-phone" label={dict.pomen.phone} />
          </div>
          <div class="amount-box">
            <AmountField
              client:load
              id="pomen-amount"
              label={dict.pomen.amount}
              hint={dict.pomen.amountHint}
              suggestedLabel={dict.pomen.suggested}
              otherLabel={dict.pomen.other}
              suggested={siteConfig.donationSuggested}
              showProgress={false}
            />
          </div>
        </FormShell>
      </div>

      <aside class="side-panel">
        <span class="side-panel__mark" aria-hidden="true"><SerbianCross size={30} decorative /></span>
        <h2>{p.sideTitle}</h2>
        <p>{p.sideText}</p>
        <ul class="side-list">
          {p.sideList.map((item, i) => (
            <li>
              <span class="side-list__icon"><Icon name={sideIcons[i]} size={20} /></span>
              <span><strong>{item}</strong></span>
            </li>
          ))}
        </ul>
        <OfficeLines locale={locale} />
      </aside>
    </div>
  </section>

  <section class="section section--parchment reveal">
    <div class="container">
      <SectionHead eyebrow={p.moreEyebrow} title={p.moreTitle} center />
      <div class="tile-grid">
        <Tile icon="home" title={dict.nav.slava} text={p.more.slava} href={href('slava')} more={c.more} />
        <Tile icon="heart" title={dict.nav.donate} text={p.more.donate} href={href('donate')} more={c.more} />
        <Tile icon="mail" title={dict.nav.contact} text={p.more.contact} href={href('contact')} more={c.more} />
      </div>
    </div>
  </section>
</BaseLayout>
