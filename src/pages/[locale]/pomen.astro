---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormShell from '../../components/FormShell.astro';
import PhoneInput from '../../components/PhoneInput';
import AmountField from '../../components/AmountField';
import Rosette from '../../icons/Rosette.astro';
import { locales, t, type Locale } from '../../i18n/ui';
import { siteConfig } from '../../config/site';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = t(locale);
---
<BaseLayout locale={locale} title={dict.pomen.title} path="pomen" description={dict.pomen.intro}>
  <section class="page-hero">
    <div class="container">
      <div class="section-ornament" style="justify-content: flex-start; margin-bottom: var(--space-3);">
        <Rosette size={28} />
      </div>
      <h1>{dict.pomen.title}</h1>
      <p>{dict.pomen.intro}</p>
    </div>
  </section>
  <section class="section" style="padding-top: 0;">
    <div class="container split-2">
      <FormShell submitLabel={dict.pomen.submit} successMessage={dict.pomen.success}>
        <div class="form-row">
          <label for="pomen-kind">{dict.pomen.living} / {dict.pomen.departed}</label>
          <select id="pomen-kind" name="kind" required>
            <option value="living">{dict.pomen.living}</option>
            <option value="departed">{dict.pomen.departed}</option>
          </select>
        </div>
        <div class="form-row">
          <label for="pomen-names">{dict.pomen.names}</label>
          <p class="hint">{dict.pomen.namesHint}</p>
          <textarea id="pomen-names" name="names" required></textarea>
        </div>
        <div class="form-row">
          <label for="pomen-name">{dict.pomen.name}</label>
          <input id="pomen-name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="form-row">
          <label for="pomen-email">{dict.pomen.email}</label>
          <input id="pomen-email" name="email" type="email" required autocomplete="email" />
        </div>
        <PhoneInput client:load id="pomen-phone" label={dict.pomen.phone} />
        <AmountField
          client:load
          id="pomen-amount"
          label={dict.pomen.amount}
          hint={dict.pomen.amountHint}
          suggestedLabel={dict.pomen.suggested}
          otherLabel={dict.pomen.other}
          suggested={siteConfig.donationSuggested}
          showProgress={false}
        />
      </FormShell>
      <div style="color: var(--lapis); display: grid; gap: var(--space-5); align-content: start;">
        <img src="/icons/censer.svg" alt="" width="64" height="80" />
        <img src="/icons/gospel.svg" alt="" width="96" height="72" />
        <img src="/icons/candle.svg" alt="" width="40" height="90" />
      </div>
    </div>
  </section>
</BaseLayout>
