---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Ornament from '../../components/Ornament.astro';
import AmountForm from '../../components/AmountForm.astro';
import { images } from '../../config/images';
import { t } from '../../i18n/ui';

const locale = 'ro' as const;
const dict = t(locale);
---
<BaseLayout locale={locale} title={dict.donate.title} current="donate">
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">{dict.nav.donate}</p>
      <h1>{dict.donate.title}</h1>
      <p class="lede">{dict.donate.intro}</p>
      <Ornament variant="arch" align="start" />
    </div>
  </header>
  <section class="section">
    <div class="container grid-2">
      <div class="card card--gold">
        <AmountForm locale={locale} kind="donate" />
      </div>
      <div class="media-frame">
        <img src={images.donate.src} alt={images.donate.alt.ro} width="900" height="600" loading="lazy" />
      </div>
    </div>
  </section>
</BaseLayout>
