---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Ornament from '../../../components/Ornament.astro';
import ContactForm from '../../../components/ContactForm.astro';
import { siteConfig } from '../../../config/site';
import { images } from '../../../config/images';
import { t } from '../../../i18n/ui';

const locale = 'en' as const;
const dict = t(locale);
const addr = siteConfig.address;
---
<BaseLayout locale={locale} title={dict.contact.title} current="contact">
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">{dict.nav.contact}</p>
      <h1>{dict.contact.title}</h1>
      <p class="lede">{dict.contact.intro}</p>
      <Ornament />
    </div>
  </header>
  <section class="section">
    <div class="container grid-2">
      <div>
        <h2>{dict.contact.address}</h2>
        <p>
          {addr.street}<br />
          {addr.city}, {addr.region} {addr.postal}<br />
          {addr.country.en}
        </p>
        <p>
          <strong>{dict.contact.phone}:</strong>
          <a href={`tel:${siteConfig.phone.replace(/\D/g, '')}`}>{siteConfig.phone}</a><br />
          <strong>{dict.contact.email}:</strong>
          <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        </p>
        {siteConfig.features.visitingBlock && (
          <>
            <h3>{dict.contact.hours}</h3>
            <p>{dict.contact.hoursText}</p>
          </>
        )}
        <p>
          <a class="btn btn-secondary" href={siteConfig.mapUrl} target="_blank" rel="noopener noreferrer">
            {dict.contact.map}
          </a>
        </p>
        <div class="media-frame" style="margin-top:1.5rem;">
          <img src={images.contact.src} alt={images.contact.alt.en} width="900" height="675" loading="lazy" />
        </div>
      </div>
      <div>
        <h2>{dict.contact.formTitle}</h2>
        <ContactForm locale={locale} />
      </div>
    </div>
  </section>
</BaseLayout>
