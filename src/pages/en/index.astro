---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Ornament from '../../components/Ornament.astro';
import ScheduleList from '../../components/ScheduleList.astro';
import { siteConfig } from '../../config/site';
import { images } from '../../config/images';
import { thisWeekServices, nextFeast, newsItems } from '../../config/schedule';
import { t } from '../../i18n/ui';
import { formatShortDate, displayDates } from '../../utils/dates';

const locale = 'en' as const;
const dict = t(locale);
const feastDates = displayDates(nextFeast.date, locale);

---
<BaseLayout locale={locale} title={dict.nav.home} current="home" description={siteConfig.tagline.en}>
  <section class="hero" aria-label="Hero">
    <div class="hero__media">
      <img src={images.hero.src} alt={images.hero.alt.en} width="1800" height="1200" fetchpriority="high" />
    </div>
    <div class="hero__shade"></div>
    <div class="container hero__content">
      <p class="eyebrow" style="color:var(--gold-bright);">{siteConfig.tagline.en}</p>
      <p class="hero__brand">{siteConfig.name.en}</p>
      <Ornament light />
      <p class="hero__text">Romanian Orthodox worship for the local community.</p>
      <div class="hero__actions">
        <a class="btn btn-gold" href={dict.paths.schedule}>{dict.home.heroCta}</a>
        <a class="btn btn-ghost" href={dict.paths.contact}>{dict.home.heroSecondary}</a>
      </div>
    </div>
    <div class="hero__floor" aria-hidden="true"><span class="hero__floor-rule"></span></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{dict.home.thisWeek}</p>
          <h2>{dict.home.thisWeek}</h2>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center;">
          <span class="calendar-badge">
            {siteConfig.calendarStyle === 'old' ? dict.schedule.calendarOld : dict.schedule.calendarNew}
          </span>
          <a class="section-link" href={dict.paths.schedule}>{dict.home.viewAll} →</a>
        </div>
      </div>
      <Ornament />
      <ScheduleList locale={locale} items={thisWeekServices} layout="week" />
    </div>
  </section>

  <section class="section section--band">
    <div class="container">
      <p class="eyebrow">{dict.home.nextFeast}</p>
      <h2>{dict.home.nextFeast}</h2>
      <Ornament />
      <div class="feast">
        <div>
          <h3>{nextFeast.title.en}</h3>
          <p>{nextFeast.description.en}</p>
          <p class="feast__date">{feastDates.primary}</p>
          <div class="feast__meta">
            <span>{nextFeast.startTime}-{nextFeast.endTime}</span>
            {feastDates.secondary && (
              <span class="old-style">{dict.schedule.oldStyleLabel}: {feastDates.secondary}</span>
            )}
          </div>
          <p style="margin-top:1.35rem;margin-bottom:0;">
            <a class="btn btn-accent" href={dict.paths.news}>{dict.home.viewAll}</a>
          </p>
        </div>
        <div class="media-frame media-frame--arch">
          <img src={images.parish.src} alt={images.parish.alt.en} width="900" height="675" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{dict.home.news}</p>
          <h2>{dict.home.news}</h2>
        </div>
        <a class="section-link" href={dict.paths.news}>{dict.home.viewAll} →</a>
      </div>
      <Ornament />
      <div class="card-grid">
        {newsItems.slice(0, 3).map((item) => (
          <article class="news-item card--lift">
            <time datetime={item.date}>{formatShortDate(item.date, locale)}</time>
            <h3>{item.title.en}</h3>
            <p style="margin:0;">{item.summary.en}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="container">
      <p class="eyebrow">{dict.home.gallery}</p>
      <h2>{dict.home.gallery}</h2>
      <Ornament />
      <div class="gallery-strip" role="list">
        {images.gallery.map((img) => (
          <figure role="listitem">
            <img src={img.src} alt={img.alt.en} width="640" height="512" loading="lazy" />
            <figcaption>{img.alt.en}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="donate-band">
    <div class="donate-band__media">
      <img src={images.donate.src} alt={images.donate.alt.en} width="1400" height="700" loading="lazy" />
    </div>
    <div class="donate-band__shade"></div>
    <div class="container donate-band__content">
      <p class="eyebrow" style="color:var(--gold-bright);">{dict.nav.donate}</p>
      <h2 style="color:var(--white);">{dict.home.donateBandTitle}</h2>
      <Ornament light />
      <p style="max-width:34ch;color:rgba(255,252,247,0.9);">{dict.home.donateBandText}</p>
      <a class="btn btn-gold" href={dict.paths.donate}>{dict.home.donateBandCta}</a>
    </div>
  </section>
</BaseLayout>
