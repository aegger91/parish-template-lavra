---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Ornament from '../../../components/Ornament.astro';
import { siteConfig } from '../../../config/site';
import { images } from '../../../config/images';
import { t } from '../../../i18n/ui';

const locale = 'en' as const;
const dict = t(locale);
---
<BaseLayout locale={locale} title={dict.livestream.title} current="livestream">
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">{dict.nav.livestream}</p>
      <h1>{dict.livestream.title}</h1>
      <p class="lede">{dict.livestream.intro}</p>
      <Ornament />
    </div>
  </header>
  <section class="section">
    <div class="container">
      <div class="livestream-frame">
        <img src={images.livestream.src} alt={images.livestream.alt.en} width="1280" height="720" />
      </div>
      <p style="margin-top:1rem;">{dict.livestream.offline}</p>
      <p>
        <a class="btn btn-secondary" href={siteConfig.livestreamUrl} target="_blank" rel="noopener noreferrer">
          {dict.livestream.openExternal}
        </a>
      </p>
      <div class="icon-row" aria-hidden="true">
        <img src="/icons/iconostasis.svg" alt="" width="44" height="44" />
        <img src="/icons/candle.svg" alt="" width="44" height="44" />
        <img src="/icons/censer.svg" alt="" width="44" height="44" />
      </div>
    </div>
  </section>
</BaseLayout>
