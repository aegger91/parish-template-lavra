---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ornament from '../components/Ornament.astro';
import ScheduleList from '../components/ScheduleList.astro';
import { siteConfig } from '../config/site';
import { images } from '../config/images';
import { thisWeekServices, nextFeast, newsItems } from '../config/schedule';
import { t } from '../i18n/ui';
import { formatShortDate, displayDates } from '../utils/dates';

const locale = 'ro' as const;
const dict = t(locale);
const feastDates = displayDates(nextFeast.date, locale);

const icons = [
  { src: '/icons/censer.svg', label: 'Cădelniță' },
  { src: '/icons/candela.svg', label: 'Candela' },
  { src: '/icons/candle.svg', label: 'Lumânare' },
  { src: '/icons/gospel.svg', label: 'Evanghelie' },
  { src: '/icons/prosphora.svg', label: 'Prescura' },
  { src: '/icons/iconostasis.svg', label: 'Iconostas' },
];
---
<BaseLayout locale={locale} title={dict.nav.home} current="home" description={siteConfig.tagline.ro}>
  <section class="hero" aria-label="Hero">
    <div class="hero__media">
      <img src={images.hero.src} alt={images.hero.alt.ro} width="1600" height="1000" fetchpriority="high" />
    </div>
    <div class="hero__shade"></div>
    <div class="container hero__content">
      <p class="hero__brand">{siteConfig.name.ro}</p>
      <p class="hero__headline">{siteConfig.tagline.ro}</p>
      <p class="hero__text">Slujire ortodoxă românească pentru comunitatea locală.</p>
      <div class="hero__actions">
        <a class="btn btn-primary" href={dict.paths.schedule}>{dict.home.heroCta}</a>
        <a class="btn btn-ghost" href={dict.paths.contact}>{dict.home.heroSecondary}</a>
      </div>
    </div>
    <div class="hero__ornament" aria-hidden="true">
      <img src="/icons/ornament-arch.svg" alt="" width="480" height="48" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{dict.home.thisWeek}</p>
          <h2>{dict.home.thisWeek}</h2>
        </div>
        <span class="calendar-badge">
          {siteConfig.calendarStyle === 'old' ? dict.schedule.calendarOld : dict.schedule.calendarNew}
        </span>
      </div>
      <Ornament variant="arch" align="start" />
      <ScheduleList locale={locale} items={thisWeekServices} />
      <p style="margin-top:1.35rem;">
        <a class="btn btn-secondary" href={dict.paths.schedule}>{dict.home.viewAll}</a>
      </p>
    </div>
  </section>

  <section class="section-tight section--layered">
    <div class="container">
      <p class="eyebrow">{dict.home.nextFeast}</p>
      <h2>{dict.home.nextFeast}</h2>
      <Ornament variant="floral" align="start" />
      <div class="feast-block">
        <div>
          <h3>{nextFeast.title.ro}</h3>
          <p>{nextFeast.description.ro}</p>
          <p class="feast-block__date">{feastDates.primary}</p>
          <div class="feast-block__meta">
            <span>{nextFeast.startTime}-{nextFeast.endTime}</span>
            {feastDates.secondary && (
              <span class="old-style">{dict.schedule.oldStyleLabel}: {feastDates.secondary}</span>
            )}
          </div>
          <p style="margin-top:1.25rem;margin-bottom:0;">
            <a class="btn btn-accent" href={dict.paths.news}>{dict.home.viewAll}</a>
          </p>
        </div>
        <div class="media-frame media-frame--arch">
          <img src={images.parish.src} alt={images.parish.alt.ro} width="900" height="675" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{dict.home.news}</p>
          <h2>{dict.home.news}</h2>
        </div>
        <a href={dict.paths.news}>{dict.home.viewAll}</a>
      </div>
      <Ornament variant="embroidery" align="start" />
      <div class="card-grid">
        {newsItems.slice(0, 3).map((item) => (
          <article class="news-item card--interactive">
            <time datetime={item.date}>{formatShortDate(item.date, locale)}</time>
            <h3>{item.title.ro}</h3>
            <p style="margin:0;">{item.summary.ro}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight section--layered">
    <div class="container">
      <p class="eyebrow">{dict.home.gallery}</p>
      <h2>{dict.home.gallery}</h2>
      <Ornament variant="rope" align="start" />
      <div class="gallery-strip" role="list">
        {images.gallery.map((img) => (
          <figure role="listitem">
            <img src={img.src} alt={img.alt.ro} width="640" height="512" loading="lazy" />
            <figcaption>{img.alt.ro}</figcaption>
          </figure>
        ))}
      </div>
      <div class="icon-gallery" aria-label="Icoane liturgice">
        {icons.map((icon) => (
          <div class="icon-tile">
            <img src={icon.src} alt="" width="40" height="40" />
            <span>{icon.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="donate-band">
    <div class="donate-band__media">
      <img src={images.donate.src} alt={images.donate.alt.ro} width="1400" height="700" loading="lazy" />
    </div>
    <div class="donate-band__shade"></div>
    <div class="container donate-band__content">
      <p class="eyebrow" style="color:var(--gold-bright);">{dict.nav.donate}</p>
      <h2 style="color:var(--white);">{dict.home.donateBandTitle}</h2>
      <Ornament variant="vine" align="start" />
      <p style="max-width:36ch;color:rgba(255,250,244,0.9);">{dict.home.donateBandText}</p>
      <a class="btn btn-ghost" href={dict.paths.donate}>{dict.home.donateBandCta}</a>
    </div>
  </section>
</BaseLayout>
