---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Ornament from '../../components/Ornament.astro';
import { siteConfig } from '../../config/site';
import { images } from '../../config/images';
import { t } from '../../i18n/ui';

const locale = 'ro' as const;
const dict = t(locale);
---
<BaseLayout locale={locale} title={dict.parish.title} current="parish">
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">{dict.nav.parish}</p>
      <h1>{dict.parish.title}</h1>
      <Ornament variant="arch" align="start" />
    </div>
  </header>

  {siteConfig.features.aboutBlock && (
    <section class="section">
      <div class="container grid-2">
        <div>
          <h2>{dict.parish.aboutTitle}</h2>
          <p class="lede">{dict.parish.aboutText}</p>
          <div class="icon-gallery" style="margin-top:1.5rem;" aria-hidden="true">
            <div class="icon-tile"><img src="/icons/censer.svg" alt="" width="40" height="40" /><span>Cădelniță</span></div>
            <div class="icon-tile"><img src="/icons/candela.svg" alt="" width="40" height="40" /><span>Candela</span></div>
            <div class="icon-tile"><img src="/icons/gospel.svg" alt="" width="40" height="40" /><span>Evanghelie</span></div>
            <div class="icon-tile"><img src="/icons/prosphora.svg" alt="" width="40" height="40" /><span>Prescura</span></div>
            <div class="icon-tile"><img src="/icons/candle.svg" alt="" width="40" height="40" /><span>Lumânare</span></div>
            <div class="icon-tile"><img src="/icons/iconostasis.svg" alt="" width="40" height="40" /><span>Iconostas</span></div>
          </div>
        </div>
        <div class="media-frame media-frame--arch">
          <img src={images.parish.src} alt={images.parish.alt.ro} width="900" height="675" />
        </div>
      </div>
    </section>
  )}

  <section class="section-tight section--layered">
    <div class="container">
      <h2>{dict.parish.clergyTitle}</h2>
      <Ornament variant="embroidery" align="start" />
      <div class="clergy-list">
        {siteConfig.clergy.map((person) => (
          <article class="clergy-card">
            <img src={person.photo} alt="" width="400" height="400" loading="lazy" />
            <div>
              <h3>{person.name}</h3>
              <p>{person.role.ro}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <div class="media-frame">
        <img src={images.interior.src} alt={images.interior.alt.ro} width="900" height="675" loading="lazy" />
      </div>
      <div class="card card--gold">
        <h2>{dict.parish.historyTitle}</h2>
        <p>{dict.parish.historyText}</p>
        {siteConfig.features.visitingBlock && (
          <>
            <Ornament variant="floral" align="start" />
            <h3>{dict.parish.visitingTitle}</h3>
            <p style="margin-bottom:0;">{dict.parish.visitingText}</p>
          </>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
