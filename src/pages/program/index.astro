---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Ornament from '../../components/Ornament.astro';
import ScheduleList from '../../components/ScheduleList.astro';
import { siteConfig } from '../../config/site';
import { thisWeekServices, upcomingEvents } from '../../config/schedule';
import { t } from '../../i18n/ui';

const locale = 'ro' as const;
const dict = t(locale);
const items = [...thisWeekServices, ...upcomingEvents.filter((e) => !thisWeekServices.find((s) => s.id === e.id))];
---
<BaseLayout locale={locale} title={dict.schedule.title} current="schedule">
  <header class="reveal page-hero">
    <div class="container">
      <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between;">
        <div>
          <p class="eyebrow">{dict.nav.schedule}</p>
          <h1>{dict.schedule.title}</h1>
        </div>
        <span class="calendar-badge">
          {siteConfig.calendarStyle === 'old' ? dict.schedule.calendarOld : dict.schedule.calendarNew}
        </span>
      </div>
      <p class="lede">{dict.schedule.intro}</p>
      <Ornament />
    </div>
  </header>
  <section class="reveal section">
    <div class="container">
      <ScheduleList locale={locale} items={items} />
    </div>
  </section>
</BaseLayout>
